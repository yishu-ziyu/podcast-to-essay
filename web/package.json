{
  "name": "podcast-to-essay-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web client for podcast-to-essay: upload audio, view transcripts, manage episodes. Wrapped with Electron.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "server": "node server/index.mjs",
    "test": "node --test server/*.test.mjs && node --experimental-strip-types --test src/*.test.ts",
    "build": "vite build",
    "predeploy": "sh scripts/predeploy.sh",
    "electron": "electron .",
    "electron:dev": "IS_DEV=1 electron .",
    "electron:prod": "npm run build && IS_DEV=0 electron ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
