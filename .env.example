# 誊清配置示例。
# 本地开发：复制为仓库根目录的 .env.local
# Docker 自部署：复制为 web/.env（docker-compose.yml 读取它）

# ---- 必填 ----
# StepFun 密钥，用于语音识别和文章整理
STEP_API_KEY=

# ---- 访问控制 ----
# 设置后，只有输入密码的人是所有者，其他人是游客；不设置则所有人都是所有者。
# 部署到公网时务必设置。
ACCESS_PASSWORD=

# 游客每天的额度（仅在设置了 ACCESS_PASSWORD 时生效）
GUEST_INGEST_PER_DAY=5
GUEST_TRANSCRIBE_PER_DAY=3
GUEST_CLEAN_PER_DAY=3

# ---- 可选：模型与接口 ----
# STEP_API_BASE=https://api.stepfun.com/step_plan/v1
# STEP_ASR_MODEL=stepaudio-2.5-asr
# STEP_ARTICLE_MODEL=step-3.7-flash
# STEP_ARTICLE_BASE_URL=

# ---- 可选：运行环境 ----
# 单个上传文件的上限（字节），默认 512 MB
# MAX_UPLOAD_BYTES=536870912
# 数据目录，默认仓库根目录；Docker 镜像内为 /data
# DATA_ROOT=
# 监听地址与端口；Docker 镜像内为 0.0.0.0:8787
# HOST=127.0.0.1
# PORT=8787
# 外部工具路径，默认从 PATH 查找
# YTDLP_BIN=yt-dlp
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# 需要登录才能下载的站点，可提供 yt-dlp 的 cookies 文件
# YTDLP_COOKIES=~/.config/yt-dlp/cookies.txt
